# URL of the FastAPI backend. Public: it is shipped to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Maps JavaScript API key (restrict it: HTTP referrers = your domains,
# APIs = Maps JavaScript API + Directions API). Leave empty to use the
# OpenStreetMap fallback map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID (Google Cloud > Map Management) for vector maps / AdvancedMarkers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
