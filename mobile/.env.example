# Backend address baked into the build. In Expo Go you can also change it in
# the app: Welcome / Sign in -> "Server connection".
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Google Maps SDK for Android key for EAS/standalone builds (restrict it to
# package com.safetrail.tourist + your SHA-1). Not needed for Expo Go.
GOOGLE_MAPS_ANDROID_API_KEY=
