# ---- Copy to backend/.env for local development. Never commit .env. ----

# Database. Default: the existing local SQLite file (never deleted; backed up
# automatically before schema upgrades). Production: PostgreSQL URL.
# DATABASE_URL=sqlite:///./tourist_safety.db
# DATABASE_URL=postgresql://user:password@host:5432/safetrail

ENVIRONMENT=development
# Production requires a random value of 32+ characters.
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# First super admin (created once if the email does not exist yet).
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=ChooseAStrongPassword1

# Local demo staff accounts (see README). Ignored when ENVIRONMENT=production.
SEED_DEMO_STAFF=true

# Email for OTP codes and SOS alerts: brevo | resend | smtp | none
EMAIL_PROVIDER=none
# EMAIL_API_KEY=
# EMAIL_FROM=verified-sender@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
ADMIN_ALERT_EMAIL=

# DEMO ONLY: show OTP codes in the app when no email provider is configured.
OTP_DEV_ECHO=true

# Expo push notifications (no key needed; optional access token).
EXPO_PUSH_ENABLED=false
# PUSH_NOTIFICATION_CREDENTIALS=

GOOGLE_MAPS_API_KEY=
LOCATION_RETENTION_DAYS=30
STALE_LOCATION_MINUTES=15
OTP_TTL_SECONDS=300
